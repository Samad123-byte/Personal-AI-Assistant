# Only needed for local development, where the frontend (Vite, port 5173)
# and backend (Express, port 5000) run on different ports.
VITE_API_URL=http://localhost:5000

# In production (deployed as one Vercel project), leave this unset.
# The frontend then calls a relative /api/chat, which Vercel routes
# to the backend automatically since both live on the same domain.
